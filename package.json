{
  "name": "kelly-stakes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/web",
    "packages/kelly"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace @kelly-stakes/web --",
    "build": "npm run build:web && npm run build:extensions",
    "build:web": "npm run build --workspace @kelly-stakes/web",
    "build:extensions": "node scripts/build-extensions.mjs",
    "preview": "npm run preview --workspace @kelly-stakes/web --",
    "lint": "npm run lint --workspace @kelly-stakes/web",
    "typecheck": "npm run typecheck --workspace @kelly-stakes/web",
    "test": "node --test packages/kelly/test/*.test.js"
  },
  "devDependencies": {
    "esbuild": "0.25.8"
  }
}
